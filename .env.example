# SchoolManage App - variables d'environnement partagees (dev)
# Convention : SM_{DOMAINE}_{PARAM}  (cf. section 8.1 du document de conception)
# Copier ce fichier en ".env" (a la racine) avant de lancer docker compose.

# --- Postgres (partage en DEV : une base par service, cf. init-db.sql) ---
POSTGRES_USER=schoolmanage
POSTGRES_PASSWORD=schoolmanage_dev_pwd
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BROKER=kafka:9092
KAFKA_ZOOKEEPER=zookeeper:2181

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=schoolmanage
MINIO_ROOT_PASSWORD=schoolmanage_dev_pwd
MINIO_ENDPOINT=http://minio:9000

# --- JWT (auth-service) ---
SM_AUTH_JWT_SECRET=change-me-in-prod-please
SM_AUTH_ACCESS_TTL_MIN=15
SM_AUTH_REFRESH_TTL_DAYS=7

# --- Mobile Money (payment-service) ---
SM_PAYMENT_MTN_API_KEY=changeme
SM_PAYMENT_MTN_API_URL=https://sandbox.momodeveloper.mtn.com
SM_PAYMENT_ORANGE_API_KEY=changeme
SM_PAYMENT_ORANGE_API_URL=https://api.orange.com/orange-money-webpay

# --- Notifications (notification-service) ---
SM_NOTIFICATION_SENDGRID_API_KEY=changeme
SM_NOTIFICATION_TWILIO_SID=changeme
SM_NOTIFICATION_TWILIO_TOKEN=changeme
SM_NOTIFICATION_FCM_SERVER_KEY=changeme

# --- WhatsApp Cloud API (whatsapp-service) ---
SM_WHATSAPP_CLOUD_API_TOKEN=changeme
SM_WHATSAPP_PHONE_NUMBER_ID=changeme
SM_WHATSAPP_MONGO_URI=mongodb://mongo:27017/sm_whatsapp

# --- Config / Discovery ---
SM_CONFIG_SERVER_URL=http://sm-config-service:8080
SM_REGISTRY_URL=http://sm-registry-service:8761/eureka
SM_GATEWAY_URL=http://sm-gateway-service:8888
